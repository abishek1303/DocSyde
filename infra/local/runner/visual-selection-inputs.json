      "sourceInputSha256": "2d6fafe663f7dd1ab14b52983fe6bc1a557204684c221efca7f0fbcce49e99e0",
      "input": {
        "workflow": "Observe Resolved terminology in request list and seeded closed-request details. Optional image represents details. Display observation does not prove domain values, transitions, persistence or historical behavior.",
        "viewport": {
          "width": 1440,
          "height": 900
        },
        "findings": [
          {
            "id": "source-1",
            "kind": "behavior-modified",
            "description": "Request list now displays closed requests as \u201cResolved\u201d. Each <li> contains an <a> to /requests/:id plus a span ` \u2014 {statusLabel} \u2014 {Urgent|Normal} priority`; label is now via requestStatusLabel where closed \u2192 \u201cResolved\u201d and open \u2192 \u201copen\u201d.",
            "before": "List span used ` \u2014 ${request.status} \u2014 ${priority === \"urgent\" ? \"Urgent\" : \"Normal\"} priority` showing 'closed' for closed requests.",
            "after": "List span uses ` \u2014 ${requestStatusLabel(request.status)} \u2014 ...` showing 'Resolved' for closed requests and 'open' for open requests.",
            "support": "directly-supported",
            "uncertainties": []
          },
          {
            "id": "source-2",
            "kind": "behavior-modified",
            "description": "Request detail view (#request-detail) status paragraph (#request-status) now shows \u201cStatus: Resolved\u201d for closed requests instead of \u201cStatus: closed\u201d. Open requests continue to show \u201cStatus: open\u201d (lowercase).",
            "before": "Detail status was text(\"p\", `Status: ${request.status}`) with id request-status showing 'Status: closed' or 'Status: open'.",
            "after": "Detail status is text(\"p\", `Status: ${requestStatusLabel(request.status)}`) showing 'Status: Resolved' for closed via mapping closed\u2192Resolved, other\u2192open.",
            "support": "directly-supported",
            "uncertainties": []
          },
          {
            "id": "source-3",
            "kind": "behavior-modified",
            "description": "\u201cResolved\u201d is presentation-only. Closing still stores status=\"closed\" (not \"resolved\"), serialization contains no \"status\":\"resolved\", and Reopen request still restores status=\"open\".",
            "before": "No explicit presentation-only guarantee; storage value matched display.",
            "after": "Stored Request.status remains \"closed\" after closeRequest; JSON.stringify does not include \"resolved\"; reopenRequest retains existing behavior setting status to \"open\".",
            "support": "directly-supported",
            "uncertainties": []
          }
        ],
