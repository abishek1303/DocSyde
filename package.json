{
  "name": "docsyde",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate --config=infra/local/postgres/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=infra/local/postgres/drizzle.config.ts",
    "db:verify": "node --conditions=react-server --import tsx infra/local/postgres/verify-project.ts",
    "db:setup": "sh infra/local/postgres/setup.sh",
    "github:verify": "node --conditions=react-server --import tsx infra/local/github/verify-source.ts",
    "github:test": "node --conditions=react-server --import tsx --test src/integrations/github/source-reader.test.ts src/integrations/github/recent-branch.test.ts",
    "ai:test": "node --conditions=react-server --import tsx --test src/integrations/ai/generate-structured.test.ts",
    "ai:verify": "node --conditions=react-server --import tsx infra/local/ai/verify.ts",
    "ai:vision:test": "node --conditions=react-server --import tsx --test src/integrations/ai/analyze-screenshot.test.ts src/integrations/ai/meta/invoke-vision.test.ts",
    "ai:vision:verify": "node --conditions=react-server --import tsx infra/local/ai/verify-vision.ts",
    "ai:billing": "node --conditions=react-server --import tsx infra/local/ai/billing.ts",
    "ai:billing:test": "node --conditions=react-server --import tsx --test src/integrations/ai/baseten/billing.test.ts",
    "git:test": "node --conditions=react-server --import tsx --test src/integrations/local-git/source-reader.test.ts",
    "git:verify": "node --conditions=react-server --import tsx infra/local/git/verify.ts",
    "runner:test": "node --conditions=react-server --import tsx --test src/runner/runtime/*.test.ts",
    "runner:verify": "node --conditions=react-server --import tsx infra/local/runner/verify.ts",
    "runner:capture:test": "node --conditions=react-server --import tsx --test infra/local/runner/*.test.ts",
    "runner:capture:verify": "node --conditions=react-server --import tsx infra/local/runner/verify-capture.ts",
    "capture:test": "node --conditions=react-server --import tsx --test src/integrations/browser/*.test.ts",
    "storage:test": "node --conditions=react-server --import tsx --test src/integrations/storage/*.test.ts",
    "capture:verify": "node --conditions=react-server --import tsx infra/local/capture/verify.ts",
    "sdk:test": "node --import tsx --test src/sdk/*.test.ts",
    "sdk:build": "tsc -p infra/local/sdk/tsconfig.json",
    "sdk:verify": "npm run sdk:build && node --import tsx infra/local/sdk/verify.ts",
    "sources:test": "node --conditions=react-server --import tsx --test src/features/sources/*.test.ts",
    "sources:verify": "node --conditions=react-server --import tsx infra/local/sources/verify.ts",
    "sources:context:verify": "node --conditions=react-server --import tsx infra/local/sources/verify-context.ts",
    "sources:product:verify": "node --conditions=react-server --import tsx infra/local/sources/verify-product-changes.ts",
    "documentation:runs:test": "node --conditions=react-server --import tsx --test infra/local/documentation/run-workflow.test.ts",
    "documentation:test": "node --conditions=react-server --import tsx --test src/features/documentation/*.test.ts",
    "documentation:verify": "node --conditions=react-server --import tsx infra/local/documentation/verify-draft.ts",
    "documentation:context:test": "node --conditions=react-server --import tsx --test infra/local/documentation/repository-context.test.ts",
    "documentation:persistence:test": "node --conditions=react-server --import tsx --test infra/local/documentation/persistence.test.ts",
    "documentation:persistence:verify": "node --conditions=react-server --import tsx infra/local/documentation/verify-persistence.ts",
    "documentation:publications:test": "node --conditions=react-server --import tsx --test infra/local/documentation/publications.test.ts",
    "documentation:publications:verify": "node --conditions=react-server --import tsx infra/local/documentation/verify-publication.ts",
    "runtime:visual:verify": "node --conditions=react-server --import tsx infra/local/runner/verify-visual-selection.ts",
    "runtime:visual:test": "node --conditions=react-server --import tsx --test src/integrations/browser/capture-trace.test.ts src/runner/runtime/capture-workflow.test.ts src/features/sources/runtime-visual-analysis.test.ts infra/local/runner/visual-workflow.test.ts",
    "documentation:transform:test": "node --conditions=react-server --import tsx --test src/features/documentation/document-v2*.test.ts src/features/documentation/transformation*.test.ts infra/local/documentation/transformation-workflow.test.ts",
    "documentation:transform:persistence:test": "node --conditions=react-server --import tsx --test infra/local/documentation/transformation-persistence.test.ts",
    "documentation:transform:verify": "node --conditions=react-server --import tsx infra/local/documentation/verify-transformation.ts",
    "documentation:review": "node --conditions=react-server --import tsx infra/local/documentation/review.ts",
    "documentation:review:test": "node --conditions=react-server --import tsx --test src/features/documentation/documentation-review.test.ts infra/local/documentation/review-workflow.test.ts",
    "documentation:review:verify": "node --conditions=react-server --import tsx --test infra/local/documentation/review-workflow.test.ts",
    "documentation:library:test": "node --conditions=react-server --import tsx --test infra/local/documentation/library.test.ts src/features/sources/prepare-comparison.test.ts",
    "documentation:runs:unit:test": "node --conditions=react-server --import tsx --test src/features/documentation/run-failure.test.ts src/features/documentation/prepare-run.test.ts src/features/documentation/run-workflow-state.test.ts infra/local/documentation/run-stage-response.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
