{
  "baseUrl": "http://127.0.0.1:45873",
  "path": "/requests/new",
  "readySelector": "#app[data-ready=true]",
  "steps": [
    {
      "type": "fill",
      "selector": "#title",
      "value": "Access request"
    },
    {
      "type": "fill",
      "selector": "#description",
      "value": "Please enable the reporting page."
    },
    {
      "type": "click",
      "selector": "button[type=submit]"
    },
    {
      "type": "waitFor",
      "selector": "#created"
    }
  ],
  "regions": [
    {
      "name": "request",
      "selector": "#request-detail"
    }
  ],
  "outputDirectory": "test-app/.artifacts/captures"
}
