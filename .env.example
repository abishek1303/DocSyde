# Local development only. Keep DATABASE_URL in sync if these values change.
POSTGRES_USER=docsyde
POSTGRES_PASSWORD=docsyde_local
POSTGRES_DB=docsyde
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docsyde:docsyde_local@localhost:5432/docsyde

# Discover local infrastructure from the repository root.
COMPOSE_FILE=infra/local/compose.yaml

# Server-only local artifact storage; relative to the application working directory.
DOCSYDE_STORAGE_DIRECTORY=.artifacts/storage

# GitHub source inspection only; not needed to render the app.
# Recommended: a fine-grained token with Contents: read on selected repositories.
GITHUB_TOKEN=

# Text-only model capability proof; no credentials required for rendering/tests.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Signs generated documentation previews for explicit saving. Server-only; use
# at least 32 random characters (for example: openssl rand -hex 32).
# Not required for generation, saved-draft browsing, or PostgreSQL-only tests.
DOCSYDE_DRAFT_SIGNING_KEY=

# Read-only local Request Desk delivery; one exact browser origin, no credentials.
DOCSYDE_HOST_ORIGIN=http://127.0.0.1:45873
