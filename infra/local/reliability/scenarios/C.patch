+test("Resolved is presentation only; close and reopen preserve domain values", () => {
+  const initial = initialRequests();
+  assert.equal(initial[1].status, "closed");
+  assert.equal(requestStatusLabel(initial[1].status), "Resolved");
+  const closed = closeRequest(initial, "r-001");
+  assert.equal(closed[0].status, "closed");
+  assert.equal(requestStatusLabel(closed[0].status), "Resolved");
+  assert.equal(reopenRequest(closed, "r-001")[0].status, "open");
