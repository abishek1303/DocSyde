# Local persistence (required for saved understanding, runs, documents, and MCP).
# Docker Compose supplies matching development credentials by default.
DATABASE_URL=postgresql://docsyde:docsyde_local@127.0.0.1:5432/docsyde
DOCSYDE_STORAGE_DIRECTORY=.artifacts/storage

# GitHub credentials are required for repository browsing and source reads.
# Baseten credentials are required only for new text generation/understanding.
# GitHub fine-grained token: Contents read access to the selected repositories.
GITHUB_TOKEN=
BASETEN_API_KEY=
# Exactly one target repository is required, even for application navigation.
# Replace this public demo repository if reviewing a different project.
# The single-repository safeguard is always enabled.
DOCSYDE_ANALYSIS_REPOSITORIES=abishek1303/DockSyde-demo-app-test-subject

# Meta Model API credentials, separate from Baseten.
# Muse Spark 1.3 Vision and Wonder editorial finalization use this key.
META_API_KEY=
META_COMPOSITION_MODEL=muse-wonder-1.0

# Optional local, read-only agent access. No inference credentials needed.
DOCSYDE_MCP_ENABLED=1

# Optional integrations / overrides; leave commented unless needed.
# DOCSYDE_RUN_RUNTIME_CONFIG=infra/local/runner/opentodo.example.json
# DOCSYDE_HOST_ORIGIN=http://localhost:5173
# DOCSYDE_DRAFT_SIGNING_KEY=replace-with-at-least-32-random-characters
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# META_VISION_MODEL=muse-spark-1.3
# BASETEN_STRUCTURED_OUTPUT_MODE=auto
# DOCSYDE_MCP_URL=http://127.0.0.1:3000/api/mcp

# Optional database overrides. Update DATABASE_URL to match.
# POSTGRES_USER=docsyde
# POSTGRES_PASSWORD=docsyde_local
# POSTGRES_DB=docsyde
# POSTGRES_PORT=5432

# Optional trusted Docker MCP client (exact host and port).
# DOCSYDE_MCP_DOCKER_HOST=host.docker.internal:3000

# Opt-in: higher inference cost; restart the app after changing.
DEMO_RELIABILITY_MODE=false
